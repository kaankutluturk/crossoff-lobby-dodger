{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/kaankutluturk/crossoff-lobby-dodger/main/blacklist/schema.json",
  "title": "CrossOff Lobby Dodger blacklist",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "updatedAt", "entries"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "updatedAt": { "type": "string", "format": "date-time" },
    "entries": {
      "type": "array",
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "group",
        "aliases",
        "reason",
        "evidenceUrl",
        "addedAt",
        "active"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 100,
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "group": { "type": "string", "minLength": 1, "maxLength": 100 },
        "aliases": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 3, "maxLength": 64 }
        },
        "reason": { "type": "string", "minLength": 3, "maxLength": 300 },
        "evidenceUrl": { "type": "string", "format": "uri", "maxLength": 2048 },
        "addedAt": { "type": "string", "format": "date-time" },
        "active": { "type": "boolean" }
      }
    }
  }
}
